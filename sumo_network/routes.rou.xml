<?xml version="1.0" encoding="UTF-8"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/routes_file.xsd">

    <!-- Types de véhicules -->
    <vType id="rapidgo" accel="2.6" decel="4.5" sigma="0.5" length="4.5" maxSpeed="13.89" color="1,0,0"/>
    <vType id="normal"  accel="2.6" decel="4.5" sigma="0.5" length="4.5" maxSpeed="13.89" color="0.3,0.3,0.3"/>

    <!-- Flotte RapidGo : traverse tout le corridor d'ouest en est (J0 -> J1 -> J2 -> J3) -->
    <flow id="rapidgo_flow" type="rapidgo" from="E0" to="E2" begin="0" end="3600" period="30" departSpeed="max"/>

    <!-- Trafic general sur le meme corridor (non privilegie) -->
    <flow id="corridor_normal" type="normal" from="E0" to="E2" begin="0" end="3600" period="45" departSpeed="max"/>

    <!-- Trafic transversal a l'intersection J1 (nord-sud) -->
    <flow id="j1_south_to_north" type="normal" from="-E6" to="E5" begin="0" end="3600" period="25" departSpeed="max"/>
    <flow id="j1_north_to_south" type="normal" from="-E5" to="E6" begin="0" end="3600" period="25" departSpeed="max"/>

    <!-- Trafic transversal a l'intersection J2 (nord-sud) -->
    <flow id="j2_south_to_north" type="normal" from="-E4" to="E3" begin="0" end="3600" period="25" departSpeed="max"/>
    <flow id="j2_north_to_south" type="normal" from="-E3" to="E4" begin="0" end="3600" period="25" departSpeed="max"/>

    <!-- Trafic qui tourne depuis les branches vers le corridor (realisme supplementaire) -->
    <flow id="j1_turn_in" type="normal" from="-E5" to="E1" begin="0" end="3600" period="60" departSpeed="max"/>
    <flow id="j2_turn_in" type="normal" from="-E3" to="-E1" begin="0" end="3600" period="60" departSpeed="max"/>

</routes>